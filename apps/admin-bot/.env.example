# Токен админ-бота от @BotFather. Никому не показывать и не коммитить.
ADMIN_BOT_TOKEN=123456:ABC-DEF...

# База с расходом токенов. На сервере она уже есть в корневом .env,
# поэтому чаще всего это поле остаётся пустым.
DATABASE_URL=

# Чат владельца: ему приходят отчёты. Пусто — владельцем станет тот,
# кто первым напишет /start, и бот запомнит его.
ADMIN_CHAT_ID=

# Час ежедневного отчёта по московскому времени.
ADMIN_REPORT_HOUR=21

# Цена миллиона токенов в рублях. Ноль — деньги не считаются.
ADMIN_TOKEN_PRICE_PER_MILLION=0

# Адрес сайта: бот проверяет, что сайт отвечает (/health).
SITE_URL=http://localhost:3000
