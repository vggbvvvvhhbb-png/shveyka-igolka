# Токен бота от @BotFather (обязательно). Никому не показывай и не коммить.
BOT_TOKEN=123456:ABC-DEF...

# Адрес сайта без слеша в конце. Нужен для кнопок «Открыть сайт» и «Спросить помощника».
# Локально: http://localhost:3000
SITE_URL=http://localhost:3000

# Куда складывать историю проектов и состояние диалогов (папка внутри apps/bot).
DATA_DIR=./data

# Telegram ID пользователей, которым открыт доступ, через запятую. Пусто — бот открыт для всех.
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Адрес сайта, куда бот пишет записи в журнал шитья (/sewn, /year).
# В docker-compose уже задаётся автоматически: http://web:3000
# Локально, если сайт запущен на 3000: http://localhost:3000
WEB_API_URL=http://localhost:3000

# Ключ владельца — тот же, что OWNER_KEY в корневом .env.
# Если он задан на сайте, журнал шитья закрыт замком и бот должен его знать,
# иначе записи будут отклоняться с 401. Пусто — журнал открыт.
OWNER_KEY=
