# ─────────────────────────────────────────────────────────────
# База данных
# Локально: Supabase CLI (supabase start) поднимает Postgres на порту 54322.
# Прод: строка подключения из Supabase Dashboard → Project Settings → Database.
# На serverless используй пулер соединений (Supavisor): в строке подключения
# должно быть имя пользователя в формате postgres.<project-ref>.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# ─────────────────────────────────────────────────────────────
# AI-провайдер для /api/chat.
# Допустимые значения: kimi | anthropic | openrouter | relay
# Значение по умолчанию, если переменная не задана, — kimi.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=kimi

# Kimi (api.moonshot.ai) — используется, если AI_PROVIDER=kimi
KIMI_API_KEY=

# Anthropic (api.anthropic.com) — используется, если AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenRouter (openrouter.ai) — используется, если AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# Relay (relay.fast) — используется, если AI_PROVIDER=relay.
# Формат API совместим с OpenAI, поэтому тело запроса собирается так же.
RELAY_API_KEY=
RELAY_BASE_URL=https://relay.fast
RELAY_MODEL=gpt-5.6-terra

# ─────────────────────────────────────────────────────────────
# Режимы работы помощника: «Поиск», «Рассуждение», «Ресёрч».
# Работают через отдельный маршрут /api/assistant: он ищет в интернете
# через Exa и отвечает моделью APInex. Режим «Каталог» остаётся
# на /api/chat и перечисленных выше провайдерах.
#
# Ключи серверные: в браузер они не попадают.
# ─────────────────────────────────────────────────────────────

# Exa (api.exa.ai) — поиск страниц в интернете
EXA_API_KEY=

# APInex (api.apinex.bond) — ответы моделей для режимов с интернетом
APINEX_API_KEY=

# Базовый адрес APInex. Менять нужно, только если провайдер сменится.
APINEX_BASE_URL=https://api.apinex.bond/v1

# Цепочки моделей: список через запятую, пробуются по порядку.
# Необязательно: если переменная не задана, берётся цепочка по умолчанию
# (free/gpt-6-luna, затем free/kimi-k3).
# Модели с префиксом free/ идут по бесплатному тарифу: он требует ежедневного
# подтверждения на apinex.bond/overview, без него провайдер отвечает 402 и
# режимы с интернетом не работают. Поэтому следом за бесплатной моделью
# стоит платная — она отвечает, когда бесплатный тариф недоступен.
# Платные модели Claude из цепочек лучше не оставлять: провайдер требует
# пополнения баланса именно для моделей Anthropic.
# Идентификаторы берутся из списка моделей провайдера.
MODELS_FAST=free/gpt-6-luna,gpt-6-luna,deepseek-v4-flash,gemini-3.8-flash
MODELS_REASON=free/qwen-3.8-max,deepseek-v4-pro,gpt-6-luna,gemini-3.8-flash
MODELS_NAVIGATOR=free/gpt-6-luna,gpt-6-luna,deepseek-v4-flash

# Пауза перед повтором запроса, когда провайдер ответил «слишком часто».
# В миллисекундах; 4000 — 4 секунды, второй повтор ждёт вдвое дольше.
LLM_RATE_LIMIT_BACKOFF_MS=4000

# Лимит запросов к режимам с интернетом с одного адреса в минуту.
# Обычный чат ограничен отдельно (20 запросов в минуту).
AI_RATE_LIMIT_PER_MIN=8

# ─────────────────────────────────────────────────────────────
# Название приложения в интерфейсе
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Shveyka
# ─────────────────────────────────────────────────────────────
# Публичный адрес сайта.
# Нужен для sitemap, robots.txt, канонических ссылок и разметки.
# Без него подставляется http://localhost:3000.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shveyka.example

# ─────────────────────────────────────────────────────────────
# Адрес Telegram-бота Швейки.
# Кнопка «Открыть бота» в подвале и на странице помощника.
# Без переменной берётся бот в проде: @shveyka_igolka_bot.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/shveyka_igolka_bot

# ─────────────────────────────────────────────────────────────
# Ключ владельца.
# Пусто — мерки и журнал доступны всем, как раньше.
# Задано — только владелец с этим ключом видит личные страницы.
# ─────────────────────────────────────────────────────────────
OWNER_KEY=

# ─────────────────────────────────────────────────────────────
# Письма с формы обращений (/contacts).
# Обращения уходят письмом на почту владельца и остаются в базе.
#
# Для Gmail нужен пароль приложения, а не пароль аккаунта:
# Google Account → Security → 2-Step Verification → App passwords.
# Без SMTP_USER и SMTP_PASS письма не отправляются: обращение всё равно
# сохраняется в базе, а человеку показывается подсказка.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Куда приходят обращения.
CONTACT_EMAIL=vggbvvvvhhbb@gmail.com

# ─────────────────────────────────────────────────────────────
# Общий счётчик запросов (Upstash Redis).
# Пусто — лимит живёт в памяти процесса и работает только
# на одном инстансе. Задано — лимит общий для всех инстансов.
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
