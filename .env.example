# ─────────────────────────────────────────────────────────────
# База данных
# Локально: Supabase CLI (supabase start) поднимает Postgres на порту 54322.
# Прод: строка подключения из Supabase Dashboard → Project Settings → Database.
# На serverless используй пулер соединений (Supavisor): в строке подключения
# должно быть имя пользователя в формате postgres.<project-ref>.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# ─────────────────────────────────────────────────────────────
# AI-провайдер для /api/chat.
# Допустимые значения: kimi | anthropic | openrouter | relay
# Значение по умолчанию, если переменная не задана, — kimi.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=kimi

# Kimi (api.moonshot.ai) — используется, если AI_PROVIDER=kimi
KIMI_API_KEY=

# Anthropic (api.anthropic.com) — используется, если AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenRouter (openrouter.ai) — используется, если AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# Relay (relay.fast) — используется, если AI_PROVIDER=relay.
# Формат API совместим с OpenAI, поэтому тело запроса собирается так же.
RELAY_API_KEY=
RELAY_BASE_URL=https://relay.fast
RELAY_MODEL=gpt-5.6-terra

# ─────────────────────────────────────────────────────────────
# Название приложения в интерфейсе
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Shveyka

# ─────────────────────────────────────────────────────────────
# Публичный адрес сайта.
# Нужен для sitemap, robots.txt, канонических ссылок и разметки.
# Без него подставляется http://localhost:3000.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shveyka.example

# ─────────────────────────────────────────────────────────────
# Ключ владельца.
# Пусто — мерки и журнал доступны всем, как раньше.
# Задано — только владелец с этим ключом видит личные страницы.
# ─────────────────────────────────────────────────────────────
OWNER_KEY=

# ─────────────────────────────────────────────────────────────
# Общий счётчик запросов (Upstash Redis).
# Пусто — лимит живёт в памяти процесса и работает только
# на одном инстансе. Задано — лимит общий для всех инстансов.
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
