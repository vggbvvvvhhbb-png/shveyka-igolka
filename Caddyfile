# Обратный прокси для shveyka-igolka.ru.
#
# Caddy сам берёт сертификат Let's Encrypt и перевыпускает его.
# Пока домен не указывает на сервер, сертификат не получится —
# Caddy будет повторять попытки автоматически.

shveyka-igolka.ru {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.shveyka-igolka.ru {
	redir https://shveyka-igolka.ru{uri}
}

# Рабочий HTTPS на время, пока основной домен не переключён на этот сервер:
# sslip.io отдаёт адрес любого IP, поэтому сертификат выдаётся сразу.
34.88.114.146.sslip.io {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Доступ по IP, пока домен не настроен: сайт открывается без сертификата.
:80 {
	reverse_proxy web:3000
}
